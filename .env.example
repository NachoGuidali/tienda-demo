SECRET_KEY=django-insecure-cambia-esto-en-produccion
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3
ALLOWED_HOSTS=localhost,127.0.0.1

# Mercado Pago — obtené las claves en https://www.mercadopago.com.ar/developers
MP_ACCESS_TOKEN=TEST-your-access-token-here
MP_PUBLIC_KEY=TEST-your-public-key-here

# URL base del sitio (sin trailing slash) — usada en webhooks y redirects de MP
BASE_URL=http://localhost:8000

# Email
DEFAULT_FROM_EMAIL=hola@velo.store
ADMIN_EMAIL=admin@velo.store
# En desarrollo usar 'console'; en producción 'smtp'
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
